---
deadlock_detection: false
options:
  crash_on_yield: false
---

OrderStatus = enum("CREATED", "DELIVERING", "DELIVERED")
IdempotencyStatus = enum("PROCESSING", "DONE")
OrderResult = enum("INIT", "PROCESSING", "FAILED", "ORDERED", "CONFLICT")
DeliveryResult = enum("INIT", "PROCESSING", "FAILED", "DELIVERED", "CONFLICT", "NOT_FOUND", "ALREADY_DELIVERED")
PersistenceResult = enum("SUCCEEDED", "FAILED", "CONFLICT", "NOT_FOUND", "ALREADY_DELIVERED")

always assertion DoneIdempotencyRecordHasOrder:
  for request_id in dynamodb.order_idempotency_records:
    record = dynamodb.order_idempotency_records[request_id]
    if record["status"] == IdempotencyStatus.DONE:
      if not record["order_id"] in mysql.order_records:
        return False

      order = mysql.order_records[record["order_id"]]
      if order["request_id"] != request_id or order["payload"] != record["payload"]:
        return False
  return True

always assertion DeliveredOrderHasDynamoDBDeliveryRecord:
  for order_id in mysql.order_records:
    order = mysql.order_records[order_id]
    if order["status"] == OrderStatus.DELIVERED:
      if order["delivery_id"] not in dynamodb.delivery_records:
        return False
      delivery = dynamodb.delivery_records[order["delivery_id"]]
      if delivery["order_id"] != order_id or delivery["data"] != order["delivery_data"]:
        return False
  return True

always assertion DynamoDBDeliveryRecordMatchesOrder:
  for delivery_id in dynamodb.delivery_records:
    delivery = dynamodb.delivery_records[delivery_id]

    if not delivery["order_id"] in mysql.order_records:
      return False

    order = mysql.order_records[delivery["order_id"]]
    if order["status"] != OrderStatus.DELIVERING and order["status"] != OrderStatus.DELIVERED:
      return False
    if order["delivery_id"] != delivery_id or order["delivery_data"] != delivery["data"]:
      return False
  return True

eventually always assertion RequestsSettle:
  order_settled = order_server.result != OrderResult.INIT and order_server.result != OrderResult.PROCESSING
  delivery_settled = delivery_server.result != DeliveryResult.INIT and delivery_server.result != DeliveryResult.PROCESSING
  return order_settled and delivery_settled

role DynamoDB:
  action Init:
    self.order_idempotency_records = {}
    self.delivery_records = {}

  atomic func begin_order_idempotent_request(request_id, payload):
    succeeds = oneof [True, False]
    if not succeeds:
      return PersistenceResult.FAILED

    if request_id not in self.order_idempotency_records:
      self.order_idempotency_records[request_id] = {"payload": payload, "status": IdempotencyStatus.PROCESSING, "order_id": None}
    elif self.order_idempotency_records[request_id]["payload"] != payload:
      return PersistenceResult.CONFLICT
    return PersistenceResult.SUCCEEDED

  atomic func end_order_idempotent_request(request_id, order_id):
    succeeds = oneof [True, False]
    if not succeeds:
      return False

    record = self.order_idempotency_records[request_id]
    record["order_id"] = order_id
    record["status"] = IdempotencyStatus.DONE
    return True

  atomic func create_delivery_record(delivery_id, order_id, data):
    succeeds = oneof [True, False]
    if not succeeds:
      return PersistenceResult.FAILED

    delivery = {"order_id": order_id, "data": data}
    if delivery_id not in self.delivery_records:
      self.delivery_records[delivery_id] = delivery
    elif self.delivery_records[delivery_id] != delivery:
      return PersistenceResult.CONFLICT
    return PersistenceResult.SUCCEEDED

role MySQL:
  action Init:
    self.order_records = {}
    self.next_order_id = 0
    self.delivery_prepared_count = 0

  atomic func generate_order_id():
    self.next_order_id += 1
    return self.next_order_id

  atomic func create_order(request_id, payload):
    succeeds = oneof [True, False]
    if not succeeds:
      return [PersistenceResult.FAILED, None]

    for order_id in self.order_records:
      order = self.order_records[order_id]
      if order["request_id"] == request_id:
        if order["payload"] != payload:
          return [PersistenceResult.CONFLICT, None]
        return [PersistenceResult.SUCCEEDED, order_id]

    order_id = self.generate_order_id()
    self.order_records[order_id] = {"request_id": request_id, "payload": payload, "status": OrderStatus.CREATED, "delivery_id": None, "delivery_data": None}
    return [PersistenceResult.SUCCEEDED, order_id]

  atomic func generate_delivery_id():
    self.delivery_prepared_count += 1
    return "delivery-id-" + str(self.delivery_prepared_count)

  atomic func mark_order_delivering(order_id, delivery_data):
    succeeds = oneof [True, False]
    if not succeeds:
      return [PersistenceResult.FAILED, None, None]
    if order_id not in self.order_records:
      return [PersistenceResult.NOT_FOUND, None, None]

    delivery_id = self.generate_delivery_id()
    order = self.order_records[order_id]
    if order["status"] == OrderStatus.DELIVERED:
      return [PersistenceResult.ALREADY_DELIVERED, None, None]
    elif order["status"] == OrderStatus.DELIVERING and order["delivery_data"] != delivery_data:
      return [PersistenceResult.CONFLICT, None, None]
    elif order["status"] == OrderStatus.CREATED:
      order["status"] = OrderStatus.DELIVERING
      order["delivery_id"] = delivery_id
      order["delivery_data"] = delivery_data

    return [PersistenceResult.SUCCEEDED, order["delivery_id"], order["delivery_data"]]

  atomic func mark_order_delivered(order_id):
    succeeds = oneof [True, False]
    if not succeeds:
      return False
    self.order_records[order_id]["status"] = OrderStatus.DELIVERED
    return True

@conformance
role OrderServer:
  action Init:
    self.request_payload = None
    self.result = None
    self.ordered_id = None

  atomic func prepare_next_request(payload):
    self.request_payload = payload
    self.result = OrderResult.INIT

  fair action CreateOrder:
    require self.result == OrderResult.INIT
    self.result = OrderResult.PROCESSING

    idempotency_result = dynamodb.begin_order_idempotent_request(self.request_id, self.request_payload)
    if idempotency_result == PersistenceResult.FAILED:
      self.result = OrderResult.FAILED
      return
    elif idempotency_result == PersistenceResult.CONFLICT:
      self.result = OrderResult.CONFLICT
      return

    order_creation = mysql.create_order(self.request_id, self.request_payload)
    order_result, order_id = order_creation
    if order_result == PersistenceResult.FAILED:
      self.result = OrderResult.FAILED
      return
    elif order_result == PersistenceResult.CONFLICT:
      self.result = OrderResult.CONFLICT
      return

    request_marked_done = dynamodb.end_order_idempotent_request(self.request_id, order_id)
    if not request_marked_done:
      self.result = OrderResult.FAILED
      return
    self.ordered_id = order_id
    self.result = OrderResult.ORDERED

@conformance
role DeliveryServer:
  action Init:
    self.order_id = None
    self.request_delivery_data = None
    self.result = None

  atomic func prepare_next_request(delivery_data):
    self.request_delivery_data = delivery_data
    self.result = DeliveryResult.INIT

  fair action Deliver:
    require self.result == DeliveryResult.INIT
    self.result = DeliveryResult.PROCESSING

    preparation = mysql.mark_order_delivering(self.order_id, self.request_delivery_data)
    preparation_result, delivery_id, delivery_data = preparation
    if preparation_result == PersistenceResult.FAILED:
      self.result = DeliveryResult.FAILED
      return
    elif preparation_result == PersistenceResult.NOT_FOUND:
      self.result = DeliveryResult.NOT_FOUND
      return
    elif preparation_result == PersistenceResult.ALREADY_DELIVERED:
      self.result = DeliveryResult.ALREADY_DELIVERED
      return
    elif preparation_result == PersistenceResult.CONFLICT:
      self.result = DeliveryResult.CONFLICT
      return

    delivery_result = dynamodb.create_delivery_record(delivery_id, self.order_id, delivery_data)
    if delivery_result == PersistenceResult.FAILED:
      self.result = DeliveryResult.FAILED
      return
    elif delivery_result == PersistenceResult.CONFLICT:
      self.result = DeliveryResult.CONFLICT
      return

    delivered = mysql.mark_order_delivered(self.order_id)
    if not delivered:
      self.result = DeliveryResult.FAILED
      return
    self.result = DeliveryResult.DELIVERED

ORDER_DATA = ["order-data", "different-order-data"]
DELIVERY_DATA = ["delivery-data", "different-delivery-data"]

role RequestPreparator:
  action Init:
    second_order_payload = oneof ORDER_DATA
    second_delivery_data = oneof DELIVERY_DATA

    self.second_order_payload = second_order_payload
    self.second_delivery_data = second_delivery_data
    self.second_order_request_prepared = False
    self.second_delivery_request_prepared = False

  atomic action PrepareSecondOrderRequest:
    require not self.second_order_request_prepared
    require order_server.result != OrderResult.INIT and order_server.result != OrderResult.PROCESSING

    order_server.prepare_next_request(self.second_order_payload)
    self.second_order_request_prepared = True

  atomic action SetDeliveryOrder:
    require order_server.result == OrderResult.ORDERED
    require delivery_server.order_id == None

    delivery_server.order_id = order_server.ordered_id

  atomic action PrepareSecondDeliveryRequest:
    require not self.second_delivery_request_prepared
    require delivery_server.result != DeliveryResult.INIT and delivery_server.result != DeliveryResult.PROCESSING

    delivery_server.prepare_next_request(self.second_delivery_data)
    self.second_delivery_request_prepared = True

action Init:
  dynamodb = DynamoDB()
  mysql = MySQL()

  req_preparator = RequestPreparator()
  order_server = OrderServer(request_id="request-1")
  delivery_server = DeliveryServer()

  order_server.prepare_next_request(ORDER_DATA[0])
  delivery_server.prepare_next_request(DELIVERY_DATA[0])
