---
deadlock_detection: false
options:
  crash_on_yield: false
---

RequestStatus = enum("INIT", "DONE", "FAILED", "PROCESSING")

eventually always assertion BecomeDone:
  return (application.read_status == RequestStatus.DONE or application.read_status == RequestStatus.FAILED) and (application.write_status == RequestStatus.DONE or application.write_status == RequestStatus.FAILED)

eventually always assertion GetCorrectResponse:
  if application.read_status == RequestStatus.DONE:
    if application.key == "db_cache_written":
      return application.read_res_value == "foo" or application.read_res_value == "written"
    elif application.key == "db_written":
      return application.read_res_value == "bar" or application.read_res_value == "written"
    elif application.key == "not_written":
      return application.read_res_value == None or application.read_res_value == "written"
    else:
      return False
  elif application.read_status == RequestStatus.FAILED:
    return True
  else:
    return False

always assertion CachedValueIsSameWithDbOrOlder:
  if application.key in cache.cached_records:
    return cache.cached_records[application.key] in db.committed_values[application.key]
  else:
    return True

role DB:
  action Init:
    self.records = {"db_cache_written": "foo", "db_written": "bar"}
    self.committed_values = {"db_cache_written": ["foo"], "db_written": ["bar"], "not_written": []}

  atomic func read(key):
    succeeds = oneof [True, False]
    if succeeds:
      if key in self.records:
        return [self.records[key], True]
      else:
        return [None, True]
    else:
      return [None, False]

  atomic func write(key, value):
    succeeds = oneof [True, False]
    if succeeds:
      self.records[key] = value
      self.committed_values[key].append(value)
      return True
    else:
      return False

role Cache:
  action Init:
    self.cached_records = {"db_cache_written": "foo"}

  atomic func get_cached_value(key):
    succeeds = oneof [True, False]
    if succeeds:
      if key in self.cached_records:
        return [self.cached_records[key], True]
      else:
        return [None, True]
    else:
      return [None, False]

  atomic func write_cache(key, value):
    succeeds = oneof [True, False]
    if succeeds:
      self.cached_records[key] = value
      return True
    else:
      return False

  atomic func delete_cache(key):
    succeeds = oneof [True, False]
    if succeeds:
      if key in self.cached_records:
        self.cached_records.pop(key)
      return True
    else:
      return False

@conformance
role Application:
  action Init:
    self.read_status = RequestStatus.INIT
    self.write_status = RequestStatus.INIT
    self.read_res_value = None

  fair action Read:
    require self.read_status == RequestStatus.INIT
    self.read_status = RequestStatus.PROCESSING

    cache_res = cache.get_cached_value(self.key)
    cache_value, cache_succeeds = cache_res
    if not cache_succeeds:
      self.read_status = RequestStatus.FAILED
      return
    if cache_value:
      self.read_res_value = cache_value
      self.read_status = RequestStatus.DONE
      return

    res = db.read(self.key)
    db_value, db_succeeds = res
    if not db_succeeds:
      self.read_status = RequestStatus.FAILED
      return

    if db_value:
      write_cache_succeeds = cache.write_cache(self.key, db_value)
      if not write_cache_succeeds:
        self.read_status = RequestStatus.FAILED
        return

    self.read_res_value = db_value
    self.read_status = RequestStatus.DONE

  fair action Write:
    require self.write_status == RequestStatus.INIT
    self.write_status = RequestStatus.PROCESSING

    db_succeeds = db.write(self.key, self.write_value)
    if not db_succeeds:
      self.write_status = RequestStatus.FAILED
      return

    delete_cache_succeeds = cache.delete_cache(self.key)
    if not delete_cache_succeeds:
      self.write_status = RequestStatus.FAILED
      return

    self.write_status = RequestStatus.DONE

action Init:
  db = DB()
  cache = Cache()

  key = oneof ["db_cache_written", "db_written", "not_written"]
  application = Application(key=key, write_value="written")
