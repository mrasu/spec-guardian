---
deadlock_detection: false
---

RequestStatus = enum("INIT", "DONE", "PROCESSING")

eventually always assertion GetCorrectResponse:
  if cache_aside.read_status == RequestStatus.DONE:
    if cache_aside.key == "db_cache_written":
      return cache_aside.read_res_value == "foo" or cache_aside.read_res_value == "written"
    elif cache_aside.key == "db_written":
      return cache_aside.read_res_value == "bar" or cache_aside.read_res_value == "written"
    elif cache_aside.key == "not_written":
      return cache_aside.read_res_value == None or cache_aside.read_res_value == "written"
    else:
      return False
  else:
    return True

always assertion CachedValueIsSameWithDbOrOlder:
  if cache_aside.key in cache.cached_records:
    return cache.cached_records[cache_aside.key] in db.committed_values[cache_aside.key]
  else:
    return True

role DB:
  action Init:
    self.records = [{"key": "db_cache_written", "value": "foo"}, {"key": "db_written", "value": "bar"}]
    self.committed_values = {"db_cache_written": ["foo"], "db_written": ["bar"], "not_written": []}

  atomic func read(key):
    for record in self.records:
      if record["key"] == key:
        return record["value"]
    return None

  atomic func write(key, value):
    found = False
    for record in self.records:
      if record["key"] == key:
        record["value"] = value
        found = True
    if not found:
      self.records.append({"key": key, "value": value})
    self.committed_values[key].append(value)

role Cache:
  action Init:
    self.cached_records = {"db_cache_written": "foo"}

  atomic func get_cached_value(key):
    if key in self.cached_records:
      return self.cached_records[key]
    else:
      return None

  atomic func write_cache(key, value):
    self.cached_records[key] = value

  atomic func delete_cache(key):
    if key in self.cached_records:
      self.cached_records.pop(key)

@conformance
role CacheAside:
  action Init:
    self.read_status = RequestStatus.INIT
    self.write_status = RequestStatus.INIT
    self.read_res_value = None

  fair action Read:
    require self.read_status == RequestStatus.INIT
    self.read_status = RequestStatus.PROCESSING

    # Yield to allow a crash before the first I/O.
    atomic:
      pass

    cache_value = cache.get_cached_value(self.key)
    if cache_value:
      self.read_res_value = cache_value
      self.read_status = RequestStatus.DONE
      return

    db_value = db.read(self.key)

    if db_value:
      cache.write_cache(self.key, db_value)

    self.read_res_value = db_value
    self.read_status = RequestStatus.DONE

  fair action WriteAndInvalidate:
    require self.write_status == RequestStatus.INIT
    self.write_status = RequestStatus.PROCESSING

    # Yield to allow a crash before the first I/O.
    atomic:
      pass

    db.write(self.key, self.write_value)
    cache.delete_cache(self.key)

    self.write_status = RequestStatus.DONE

action Init:
  db = DB()
  cache = Cache()

  key = oneof ["db_cache_written", "db_written", "not_written"]
  cache_aside = CacheAside(key=key, write_value="written")
