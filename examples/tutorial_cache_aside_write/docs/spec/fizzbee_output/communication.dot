digraph G {
  node [shape=box];
  splines=false;
  rankdir=LR;
  "Application" [shape=none label=<<table cellpadding="14" cellspacing="8" style="dashed">
      <tr><td port="p0">Application#0</td></tr>
      <tr><td port="p1" border="0">&#x022EE;</td></tr>
      <tr><td port="p2">Application#2</td></tr>
      </table>>]
  "Application":p0 -> "DB" [label="write"];
  "Application":p2 -> "DB" [label="write"];
  "Application":p0 -> "Cache" [label="delete_cache"];
  "Application":p2 -> "Cache" [label="delete_cache"];
  "FairActionApplication" [shape=none label=<<table cellpadding="14" cellspacing="8" style="invisible"><tr>
      <td port="Write"></td>
      </tr></table>>]
  { rank=same; "Application"; "FairActionApplication"; }
  "FairActionApplication":Write -> "Application" [label="Write"];
}
