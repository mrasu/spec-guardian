---
deadlock_detection: false
---

role DB:
  action Init:
    self.records = [{"key": "cached", "value": "old"}, {"key": "uncached", "value": "old"}]

  atomic func write(key, value):
    for record in self.records:
      if record["key"] == key:
        record["value"] = value

role Cache:
  action Init:
    self.cached_records = {"cached": "old"}

  atomic func delete_cache(key):
    if key in self.cached_records:
      self.cached_records.pop(key)

@conformance
role CacheAside:
  fair action WriteAndInvalidate:
    # Yield to allow a crash before the first I/O.
    atomic:
      pass
    db.write(self.key, self.write_value)
    cache.delete_cache(self.key)

action Init:
  db = DB()
  cache = Cache()
  key = oneof ["cached", "uncached"]
  cache_aside = CacheAside(key=key, write_value="new")
